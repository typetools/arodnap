<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.arodnap</groupId>
        <artifactId>arodnap-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <!-- The arodnap command as users download it (arodnap-<version>-bin.zip and .tar.gz): the
         launcher, the command line's jars, every tool, the Checker Framework and the stubs. Its
         integration tests run that distribution: real repairs and each tool's output contract. -->
    <artifactId>arodnap-distribution</artifactId>
    <packaging>pom</packaging>
    <name>Arodnap distribution</name>
    <description>The arodnap command with everything it runs.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Arodnap's tools go into tools/, not lib/, so they are provided (and kept off the tests'
             class path). Each is one self-contained jar. -->
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-close-injector</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-owning-field-fixer</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-rlfixer</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-rlpatcher</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-field-transformations</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-ant-capture</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-maven-capture</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>arodnap-${project.version}</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- Third-party tools: two Error Prone releases (one per JDK range) cannot both be
                         dependencies, and checker.jar finds checker-qual.jar and checker-util.jar
                         next to it by these names. -->
                    <execution>
                        <id>third-party-tools</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.checkerframework</groupId>
                                    <artifactId>checker</artifactId>
                                    <version>${checkerframework.version}</version>
                                    <outputDirectory>${project.build.directory}/third-party/checker-framework</outputDirectory>
                                    <destFileName>checker.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.checkerframework</groupId>
                                    <artifactId>checker-qual</artifactId>
                                    <version>${checkerframework.version}</version>
                                    <outputDirectory>${project.build.directory}/third-party/checker-framework</outputDirectory>
                                    <destFileName>checker-qual.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.checkerframework</groupId>
                                    <artifactId>checker-util</artifactId>
                                    <version>${checkerframework.version}</version>
                                    <outputDirectory>${project.build.directory}/third-party/checker-framework</outputDirectory>
                                    <destFileName>checker-util.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.version}</version>
                                    <classifier>with-dependencies</classifier>
                                    <outputDirectory>${project.build.directory}/third-party/tools</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.jdk17.version}</version>
                                    <classifier>with-dependencies</classifier>
                                    <outputDirectory>${project.build.directory}/third-party/tools</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.eisop</groupId>
                                    <artifactId>dataflow-errorprone</artifactId>
                                    <version>${dataflow.version}</version>
                                    <outputDirectory>${project.build.directory}/third-party/tools</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stubs</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>arodnap-engine</includeArtifactIds>
                            <includes>org/arodnap/engine/stubs/*.astub</includes>
                            <outputDirectory>${project.build.directory}/engine</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/bin.xml</descriptor>
                            </descriptors>
                            <tarLongFileMode>posix</tarLongFileMode>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- A pom module compiles no tests by itself. -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>testResources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <arodnap.home>${project.build.directory}/arodnap-${project.version}-bin/arodnap-${project.version}</arodnap.home>
                        <arodnap.testProjects>${project.basedir}/../test-projects</arodnap.testProjects>
                    </systemPropertyVariables>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.arodnap:arodnap-close-injector</classpathDependencyExclude>
                        <classpathDependencyExclude>org.arodnap:arodnap-owning-field-fixer</classpathDependencyExclude>
                        <classpathDependencyExclude>org.arodnap:arodnap-rlfixer</classpathDependencyExclude>
                        <classpathDependencyExclude>org.arodnap:arodnap-rlpatcher</classpathDependencyExclude>
                        <classpathDependencyExclude>org.arodnap:arodnap-field-transformations</classpathDependencyExclude>
                        <classpathDependencyExclude>org.arodnap:arodnap-ant-capture</classpathDependencyExclude>
                        <classpathDependencyExclude>org.arodnap:arodnap-maven-capture</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
