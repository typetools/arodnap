<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.arodnap</groupId>
        <artifactId>arodnap-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>arodnap-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Arodnap Maven plugin</name>
    <description>Repairs resource leaks in a Maven project: mvn compile arodnap:repair.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <prerequisites>
        <maven>3.9.0</maven>
    </prerequisites>

    <dependencies>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.2</version>
            <scope>provided</scope>
        </dependency>
        <!-- The tools the goals download; the integration tests install them from this build. -->
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-close-injector</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-owning-field-fixer</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-rlfixer</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-rlpatcher</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.arodnap</groupId>
            <artifactId>arodnap-field-transformations</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.15.2</version>
                <configuration>
                    <goalPrefix>arodnap</goalPrefix>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ARODNAP_E2E=1 mvn verify: the goals on real builds (src/it), with the real tools. -->
        <profile>
            <id>e2e</id>
            <activation>
                <property>
                    <name>env.ARODNAP_E2E</name>
                    <value>1</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-invoker-plugin</artifactId>
                        <configuration>
                            <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                            <localRepositoryPath>${project.build.directory}/it-repository</localRepositoryPath>
                            <settingsFile>src/it/settings.xml</settingsFile>
                            <postBuildHookScript>verify</postBuildHookScript>
                            <streamLogsOnFailures>true</streamLogsOnFailures>
                            <extraArtifacts>
                                <extraArtifact>org.arodnap:arodnap-close-injector:${project.version}:jar</extraArtifact>
                                <extraArtifact>org.arodnap:arodnap-owning-field-fixer:${project.version}:jar</extraArtifact>
                                <extraArtifact>org.arodnap:arodnap-rlfixer:${project.version}:jar</extraArtifact>
                                <extraArtifact>org.arodnap:arodnap-rlpatcher:${project.version}:jar</extraArtifact>
                                <extraArtifact>org.arodnap:arodnap-field-transformations:${project.version}:jar</extraArtifact>
                            </extraArtifacts>
                        </configuration>
                        <executions>
                            <execution>
                                <id>integration-test</id>
                                <goals>
                                    <goal>install</goal>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
